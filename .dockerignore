# Docker does NOT read .gitignore. Without this file the build context is
# large (.venv) and, worse, the runtime stage's
# `COPY . /workspace/b2c_runner` would bake all of it into the image —
# including a .venv whose interpreter symlinks point at the host.

# Host virtualenvs — the image builds its own under /opt
.venv/
env/
venv/
pipeline/envs/*/venv/
pipeline/envs/*/vendor/

.git/
.gitignore

# `**/`: a bare pattern matches at the context root only, so `__pycache__/`
# alone let every tests/ and pipeline/ bytecode cache from a local pytest run
# into `COPY . /opt/b2c_runner` (~5 MB that changed with every local run).
**/__pycache__/
**/*.py[cod]
**/*$py.class

build/
dist/
**/*.egg-info/
.eggs/

.pytest_cache/
.coverage
htmlcov/

.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Working output
output/
temp/
*.pkl

# Local fp8 checkpoint experiments
.fp8-scratch/

# Figures in the research notes (docs/vace-leak-sweep alone is 16 MB of
# PNGs): nothing in the image reads them, and the code copy is re-pushed with
# every code change. The markdown stays.
docs/**/*.png
docs/**/*.jpg
