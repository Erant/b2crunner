# Brush training image, invoked per-call via `dispatch: docker`
# (pipeline/dispatch/docker.py runs `docker run --rm --gpus all -v tmp:/data
# <image> python -m pipeline.worker brush /data/inputs.pkl ...` — see
# pipeline/envs/envs.yaml's `brush` entry). Separate from Dockerfile.main
# because brush needs OS-level Vulkan/graphics capability that a plain
# Python venv (in this image or any other) can't provide regardless of
# isolation — confirmed the hard way on a real pod: NVIDIA_DRIVER_CAPABILITIES
# only exposed compute,utility there, so `vulkaninfo` failed with
# ERROR_INCOMPATIBLE_DRIVER even though the driver's Vulkan .so files were
# physically present. Baking the capability into this image (below) is what
# actually fixes it, since nvidia-container-toolkit reads it from the image
# at container-creation time.
#
# Build: docker build -f docker/Dockerfile.brush -t b2c/brush:latest .

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

# The fix: bake the capability into the image so `docker run --gpus all`
# always gets it, regardless of the host's own default (most ML host
# templates only set compute,utility).
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3-pip \
    git curl build-essential pkg-config libssl-dev \
    libvulkan1 vulkan-tools \
    ffmpeg libopencv-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    --default-toolchain 1.88.0
ENV PATH="/root/.cargo/bin:${PATH}"

# Erant/brush specifically (this fork adds normal-map supervision flags not
# in upstream ArthurBrussee/brush — --normal-loss-weight,
# --normal-loss-start-iter, --alpha-mode, --export-name; see
# pipeline/steps/brush.py). UNVERIFIED build — never actually compiled in
# this session; confirm `cargo build --release` succeeds with just
# libvulkan1/vulkan-tools before trusting this layer, add vulkan-sdk if not.
RUN git clone https://github.com/Erant/brush.git /opt/brush \
    && cd /opt/brush \
    && cargo build --release \
    && cp target/release/brush /usr/local/bin/brush

# Sanity check the binary is at least invocable headless (no display) at
# build time — fails the build loudly instead of failing silently at
# `docker run` time on some other host.
RUN brush --help

WORKDIR /workspace/b2c_runner
COPY . /workspace/b2c_runner

# pipeline.worker (invoked by DockerDispatcher) needs this package plus
# body2colmap (pipeline/steps/brush.py's only Python dependency, already in
# pyproject.toml) — no torch/diffusers/etc. needed here at all, brush.py's
# own code is plain Python + a subprocess call.
RUN python3.12 -m venv /workspace/venv_brush \
    && /workspace/venv_brush/bin/pip install --no-cache-dir --upgrade pip \
    && /workspace/venv_brush/bin/pip install --no-cache-dir -e .

# No ENTRYPOINT here on purpose: pipeline/dispatch/docker.py's
# DockerDispatcher runs `docker run ... <image> python -m pipeline.worker
# <step> ...` as an explicit command, not relying on an image ENTRYPOINT —
# setting one would make Docker append that command as ENTRYPOINT's args
# instead of running it directly, breaking the invocation. Just put
# venv_brush first on PATH so the bare `python` DockerDispatcher calls
# resolves to it.
ENV PATH="/workspace/venv_brush/bin:${PATH}"
